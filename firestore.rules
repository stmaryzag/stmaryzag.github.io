rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Utility Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' ||
        exists(/databases/$(database)/documents/admin/$(request.auth.uid))
      );
    }
    
    function isAssistant() {
      return isSignedIn() && getUserData().role == 'assistant';
    }

    // --- Admin Collection ---
    match /admin/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId) || isSignedIn();
    }

    // --- Levels & Gamification Configuration ---
    match /levels/{levelId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }

    // --- Subscriptions Collection (30 EGP) ---
    match /subscriptions/{subId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAssistant() || isSignedIn();
    }

    // --- Settings & Master Data ---
    match /areas/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }
    match /teams/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }
    match /activity_types/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }
    match /monthly_winners/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }

    // --- Records & Logs ---
    match /attendance_records/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAssistant() || isSignedIn();
    }
    match /points_log/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAssistant() || isSignedIn();
    }

    // --- Requests ---
    match /registration_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isAssistant() || isSignedIn();
    }

    // --- Afetqad (Visitation) ---
    match /afetqad_assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() || isSignedIn();
      allow update: if isSignedIn();
    }
    match /home_visits/{visitId} {
      allow read, write: if isAdmin() || isAssistant() || isSignedIn();
    }

    // --- Notifications ---
    match /notifications_scheduled/{notifId} {
      allow read, write: if isAdmin() || isSignedIn();
    }
    match /recurring_notifications/{notifId} {
      allow read, write: if isAdmin() || isSignedIn();
    }
    match /notifications_inbox/{inboxId} {
      allow read, update: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }
  }
}

